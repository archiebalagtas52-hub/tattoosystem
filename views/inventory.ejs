<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventory - Tattoo Home-Based Management System</title>

    <link rel="stylesheet" href="/css/inventory.css">

</head>

<body>

    <nav class="navbar">

        <div class="logo">
            Totats<span>Skin Art Tattoo</span>
        </div>

        <ul class="nav-links">
            <li><a href="/dashboard">Dashboard</a></li>
            <li><a href="/clientappointment">Appointment of a Client</a></li>
            <li><a href="/inventory" class="active">Inventory</a></li>
            <li><a href="/reports">Reports & Records</a></li>
            <li><a href="/photos">Photos Gallery</a></li>
            <li><a href="/logout">Logout</a></li>
        </ul>
    </nav>


    <main class="container">

        <div class="page-header">

            <div>
                <h1>Inventory</h1>
                <p>Monitor tattoo supplies and equipment.</p>
            </div>

            <button class="add-btn" onclick="openInventoryModal()">
                + Add Inventory
            </button>

        </div>


        <section class="inventory-summary">

            <div class="summary-card">
                <div>
                    <p>Total Items</p>
                    <h2 id="totalItems">0</h2>
                </div>
            </div>

            <div class="summary-card">
                <div>
                    <p>In Stock</p>
                    <h2 id="availableItems">0</h2>
                </div>
            </div>

            <div class="summary-card warning-card">
                <div>
                    <p>Low Stock</p>
                    <h2 id="lowStockItems">0</h2>
                </div>
            </div>

            <div class="summary-card danger-card">
                <div>
                    <p>Out of Stock</p>
                    <h2 id="outOfStockItems">0</h2>
                </div>
            </div>

        </section>


        <section class="inventory-controls">

            <input
                type="text"
                id="searchInventory"
                placeholder="Search inventory..."
                onkeyup="filterTable()"
            >

            <select id="categoryFilter" onchange="filterTable()">
                <option value="all">All Categories</option>
                <option value="Ink">Ink</option>
                <option value="Needles">Needles</option>
                <option value="Machines">Machines</option>
                <option value="Accessories">Accessories</option>
                <option value="Sanitation">Sanitation</option>
                <option value="Other">Other</option>
            </select>

            <select id="stockFilter" onchange="filterTable()">
                <option value="all">All Stock Status</option>
                <option value="In Stock">In Stock</option>
                <option value="Low Stock">Low Stock</option>
                <option value="Out of Stock">Out of Stock</option>
            </select>

            <button class="refresh-btn" onclick="loadInventory()">
                Refresh
            </button>

        </section>


        <section class="inventory-card">

            <div class="table-wrapper">

                <table>

                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Category</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Min Stock</th>
                            <th>Status</th>
                            <th>Stock</th>
                        </tr>
                    </thead>

                    <!-- Rows come from MongoDB via /api/inventory -->
                    <tbody id="inventoryTable">
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 40px; color: #666;">
                                Loading inventory...
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>

        </section>

    </main>


    <!-- Add Modal -->
    <div id="inventoryModal" class="modal">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h2>Add Inventory</h2>
                    <p>Add a new tattoo supply or equipment.</p>
                </div>

                <button class="close-btn" onclick="closeInventoryModal()">
                    &times;
                </button>

            </div>


            <form id="inventoryForm" onsubmit="saveItem(event)">

                <div class="form-group">

                    <label for="itemName">
                        Item Name
                    </label>

                    <input
                        type="text"
                        id="itemName"
                        placeholder="Enter item name"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="itemCategory">
                        Category
                    </label>

                    <select id="itemCategory" required>
                        <option value="">Select Category</option>
                        <option value="Ink">Ink</option>
                        <option value="Needles">Needles</option>
                        <option value="Machines">Machines</option>
                        <option value="Accessories">Accessories</option>
                        <option value="Sanitation">Sanitation</option>
                        <option value="Other">Other</option>
                    </select>

                </div>


                <div class="form-row">

                    <div class="form-group">

                        <label for="itemQuantity">
                            Quantity
                        </label>

                        <input
                            type="number"
                            id="itemQuantity"
                            min="0"
                            placeholder="0"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label for="itemPrice">
                            Price
                        </label>

                        <input
                            type="number"
                            id="itemPrice"
                            min="0"
                            step="0.01"
                            placeholder="0.00"
                            required
                        >

                    </div>

                </div>


                <div class="form-group">

                    <label for="minimumStock">
                        Minimum Stock Level
                    </label>

                    <input
                        type="number"
                        id="minimumStock"
                        min="0"
                        placeholder="Enter minimum stock"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="itemSupplier">
                        Supplier (Optional)
                    </label>

                    <input
                        type="text"
                        id="itemSupplier"
                        placeholder="Enter supplier name"
                    >

                </div>


                <div class="modal-actions">

                    <button
                        type="button"
                        class="cancel-btn"
                        onclick="closeInventoryModal()">
                        Cancel
                    </button>

                    <button
                        type="submit"
                        class="save-btn">
                        Save Inventory
                    </button>

                </div>

            </form>

        </div>

    </div>


    <script>
        var API_URL = '/api/inventory';

        // Load inventory items
        async function loadInventory() {
            try {
                var response = await fetch(API_URL);
                var items = await response.json();

                var tbody = document.getElementById('inventoryTable');

                if (!items.length) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 40px; color: #666;">
                                No items in inventory. Click "Add Inventory" to add one.
                            </td>
                        </tr>
                    `;
                    updateStats(items);
                    return;
                }

                var html = '';
                for (var i = 0; i < items.length; i++) {
                    var item = items[i];
                    var statusClass = item.status.toLowerCase().split(' ').join('-');
                    html += `
                        <tr
                            data-name="${escapeHtml(item.name)}"
                            data-category="${escapeHtml(item.category)}"
                            data-status="${escapeHtml(item.status)}"
                        >
                            <td><strong>${escapeHtml(item.name)}</strong></td>
                            <td>${escapeHtml(item.category)}</td>
                            <td>${item.quantity}</td>
                            <td>₱${Number(item.price).toFixed(2)}</td>
                            <td>${item.reorderLevel}</td>
                            <td>
                                <span class="stock-status ${statusClass}">
                                    ${item.status}
                                </span>
                            </td>
                            <td>
                                <button class="action-btn add-qty-btn" title="Add stock"
                                    onclick="updateQuantity('${item._id}', 1)">+</button>
                                <button class="action-btn remove-qty-btn" title="Remove stock"
                                    ${item.quantity <= 0 ? 'disabled' : ''}
                                    onclick="updateQuantity('${item._id}', -1)">&minus;</button>
                            </td>
                        </tr>
                    `;
                }

                tbody.innerHTML = html;

                updateStats(items);
                filterTable();

            } catch (error) {
                console.error('Error loading inventory:', error);
                document.getElementById('inventoryTable').innerHTML = `
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 40px; color: #b33c3c;">
                            Error loading inventory
                        </td>
                    </tr>
                `;
            }
        }

        // Update statistics
        function updateStats(items) {
            var inStock = 0;
            var lowStock = 0;
            var outOfStock = 0;

            for (var i = 0; i < items.length; i++) {
                var status = items[i].status;
                if (status === 'In Stock') {
                    inStock++;
                } else if (status === 'Low Stock') {
                    lowStock++;
                } else if (status === 'Out of Stock') {
                    outOfStock++;
                }
            }

            document.getElementById('totalItems').textContent = items.length;
            document.getElementById('availableItems').textContent = inStock;
            document.getElementById('lowStockItems').textContent = lowStock;
            document.getElementById('outOfStockItems').textContent = outOfStock;
        }

        // Open add modal
        function openInventoryModal() {
            document.getElementById('inventoryForm').reset();
            document.getElementById('inventoryModal').classList.add('active');
        }

        // Close modal
        function closeInventoryModal() {
            document.getElementById('inventoryModal').classList.remove('active');
        }

        // Save new item
        async function saveItem(event) {
            event.preventDefault();

            var data = {
                name: document.getElementById('itemName').value.trim(),
                category: document.getElementById('itemCategory').value,
                quantity: parseInt(document.getElementById('itemQuantity').value, 10),
                price: parseFloat(document.getElementById('itemPrice').value),
                reorderLevel: parseInt(document.getElementById('minimumStock').value, 10),
                supplier: document.getElementById('itemSupplier').value.trim()
            };

            if (!data.name || !data.category || isNaN(data.quantity) || isNaN(data.price) || isNaN(data.reorderLevel)) {
                alert('Please fill in all required fields');
                return;
            }

            try {
                var response = await fetch(API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    closeInventoryModal();
                    loadInventory();
                } else {
                    var error = await response.json();
                    alert('Error: ' + (error.error || 'Unknown error'));
                }
            } catch (error) {
                console.error('Error saving item:', error);
                alert('Error saving item');
            }
        }

        // The + and - buttons
        async function updateQuantity(id, change) {
            try {
                var response = await fetch(API_URL + '/' + id + '/quantity', {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ change: change })
                });

                if (response.ok) {
                    loadInventory();
                } else {
                    var error = await response.json();
                    alert('Error: ' + (error.error || 'Could not update quantity'));
                }
            } catch (error) {
                console.error('Error updating quantity:', error);
                alert('Error updating quantity');
            }
        }

        // Filter table
        function filterTable() {
            var search = document.getElementById('searchInventory').value.toLowerCase();
            var category = document.getElementById('categoryFilter').value;
            var status = document.getElementById('stockFilter').value;
            var rows = document.querySelectorAll('#inventoryTable tr');

            for (var i = 0; i < rows.length; i++) {
                var row = rows[i];

                if (!row.getAttribute('data-name')) {
                    continue;
                }

                var name = row.getAttribute('data-name').toLowerCase();
                var cat = row.getAttribute('data-category');
                var stat = row.getAttribute('data-status');

                var show = true;

                if (search && name.indexOf(search) === -1) {
                    show = false;
                }
                if (category !== 'all' && cat !== category) {
                    show = false;
                }
                if (status !== 'all' && stat !== status) {
                    show = false;
                }

                row.style.display = show ? '' : 'none';
            }
        }

        // Escape HTML
        function escapeHtml(text) {
            var div = document.createElement('div');
            div.textContent = text == null ? '' : text;
            return div.innerHTML;
        }

        // Close modal when clicking outside
        document.getElementById('inventoryModal').addEventListener('click', function (e) {
            if (e.target === this) {
                closeInventoryModal();
            }
        });

        // Load inventory on page load
        loadInventory();
    </script>

</body>
</html>
