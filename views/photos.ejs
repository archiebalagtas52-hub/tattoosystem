<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Photos Gallery - Tattoo Home-Based Management System</title>

    <link rel="stylesheet" href="/css/photos.css">
</head>

<body>

    <header class="navbar">

        <div class="logo">
            Totats Skin Art Tattoo
        </div>

        <ul class="nav-links">
            <li>
                <a href="/clientdashboard">Dashboard</a>
            </li>

            <li>
                <li><a href="/logout">Logout</a></li>
            </li>
        </ul>

    </header>


    <main class="container">

        <section class="page-header">

            <h1>Photos Gallery</h1>

            <p>
                Explore tattoos created by our artist and
                choose a design for your next tattoo.
            </p>

        </section>


        <section class="gallery-section">

            <div class="section-header">

                <div>
                    <h2>Client Tattoo Gallery</h2>

                    <p>
                        View tattoos previously created for our clients.
                    </p>
                </div>

            </div>


            <div class="gallery-grid">

                <div class="photo-card">

                    <div class="photo-placeholder">
                        <img
                            src="/images/client-tattoo-1.jpg"
                            alt="Client Tattoo"
                        >
                    </div>

                    <div class="photo-info">
                        <h3>Minimalist Tattoo</h3>
                        <p>Fine line tattoo design</p>
                    </div>

                </div>


                <div class="photo-card">

                    <div class="photo-placeholder">
                        <img
                            src="/images/client-tattoo-2.jpg"
                            alt="Client Tattoo"
                        >
                    </div>

                    <div class="photo-info">
                        <h3>Traditional Tattoo</h3>
                        <p>Traditional tattoo artwork</p>
                    </div>

                </div>


                <div class="photo-card">

                    <div class="photo-placeholder">
                        <img
                            src="/images/client-tattoo-3.jpg"
                            alt="Client Tattoo"
                        >
                    </div>

                    <div class="photo-info">
                        <h3>Realism Tattoo</h3>
                        <p>Detailed realism tattoo</p>
                    </div>

                </div>


                <div class="photo-card">

                    <div class="photo-placeholder">
                        <img
                            src="/images/client-tattoo-4.jpg"
                            alt="Client Tattoo"
                        >
                    </div>

                    <div class="photo-info">
                        <h3>Blackwork Tattoo</h3>
                        <p>Black ink tattoo artwork</p>
                    </div>

                </div>

            </div>

        </section>


        <section class="gallery-section">

            <div class="section-header">

                <div>
                    <h2>Tattoo Designs to Choose From</h2>

                    <p>
                        Browse our available designs and find
                        inspiration for your appointment.
                    </p>
                </div>

            </div>


            <div class="gallery-grid">

                <div class="design-card">

                    <div class="photo-placeholder">
                        <img
                            src="/images/design-1.jpg"
                            alt="Minimalist Tattoo Design"
                        >
                    </div>

                    <div class="photo-info">

                        <h3>Minimalist</h3>

                        <p>
                            Simple and clean tattoo designs.
                        </p>

                        <a
                            href="/appointment"
                            class="choose-btn">
                            Choose Design
                        </a>

                    </div>

                </div>


                <div class="design-card">

                    <div class="photo-placeholder">
                        <img
                            src="/images/design-2.jpg"
                            alt="Traditional Tattoo Design"
                        >
                    </div>

                    <div class="photo-info">

                        <h3>Traditional</h3>

                        <p>
                            Classic and bold tattoo artwork.
                        </p>

                        <a
                            href="/appointment"
                            class="choose-btn">
                            Choose Design
                        </a>

                    </div>

                </div>


                <div class="design-card">

                    <div class="photo-placeholder">
                        <img
                            src="/images/design-3.jpg"
                            alt="Tribal Tattoo Design"
                        >
                    </div>

                    <div class="photo-info">

                        <h3>Tribal</h3>

                        <p>
                            Bold tribal-inspired designs.
                        </p>

                        <a
                            href="/appointment"
                            class="choose-btn">
                            Choose Design
                        </a>

                    </div>

                </div>


                <div class="design-card">

                    <div class="photo-placeholder">
                        <img
                            src="/images/design-4.jpg"
                            alt="Custom Tattoo Design"
                        >
                    </div>

                    <div class="photo-info">

                        <h3>Custom Design</h3>

                        <p>
                            Personalized tattoo designs.
                        </p>

                        <a
                            href="/appointment"
                            class="choose-btn">
                            Choose Design
                        </a>

                    </div>

                </div>

            </div>

        </section>

    </main>

</body>
</html>

