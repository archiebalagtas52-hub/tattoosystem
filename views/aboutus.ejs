<body>

    <nav class="navbar">

        <div class="logo">
            <img src="/images/TotatsSkinArtTattoo.jpg" alt="Totats Skin Art Tattoo Logo">
            Totats<span>Skin Art Tattoo</span>
        </div>

        <ul class="nav-links">
            <li><a href="/clientdashboard">Dashboard</a></li>
            <li><a href="/photos">Photos</a></li>
            <li><a href="/aboutus" class="active">About Us</a></li>
            <li><a href="/logout">Logout</a></li>
        </ul>
    </nav>


    <main class="about-container">

        <section class="about-hero">
            <h1>About Us</h1>
            <p>
                Welcome to Tattoo Home-Based Management System,
                a convenient platform designed to make tattoo
                appointment management simple and organized.
            </p>
        </section>


        <section class="about-content">

            <div class="about-card">
                <h2>Our Purpose</h2>

