<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/dashboard.css">
    <title>Tattoo Home-Based Management System</title>
</head>

<body>

    <nav class="navbar">

        <div class="logo">
            Totats<span>Skin Art Tattoo</span>
        </div>

        <ul class="nav-links">
            <li><a href="#" class="active">Dashboard</a></li>
            <li><a href="/clientappointment">Appointment of an Client</a></li>
            <li><a href="/inventory">Inventory</a></li>
            <li><a href="/report&records">Reports & Records</a></li>
            <li><a href="/photos">Photos gallery</a></li>
            <li><a href="/logout">Logout</a></li>
        </ul>
    </nav>

    <main class="dashboard-main">

        <section class="tattoo-gallery">

            <h2 class="section-title">Recent Tattoo Works</h2>

            <div class="gallery-grid">

                <figure class="gallery-item">
                    <img src="/images/tattoo1.jpg" alt="Sleeve tattoo" loading="lazy">
                    <figcaption>Full Sleeve</figcaption>
                </figure>

                <figure class="gallery-item">
                    <img src="/images/tattoo2.jpg" alt="Back piece tattoo" loading="lazy">
                    <figcaption>Back Piece</figcaption>
                </figure>

                <figure class="gallery-item">
                    <img src="/images/tattoo3.jpg" alt="Minimalist line tattoo" loading="lazy">
                    <figcaption>Minimalist Line</figcaption>
                </figure>

                <figure class="gallery-item">
                    <img src="/images/tattoo4.jpg" alt="Traditional tattoo" loading="lazy">
                    <figcaption>Traditional</figcaption>
                </figure>

                <figure class="gallery-item">
                    <img src="/images/tattoo5.jpg" alt="Blackwork tattoo" loading="lazy">
                    <figcaption>Blackwork</figcaption>
                </figure>

                <figure class="gallery-item">
                    <img src="/images/tattoo6.jpg" alt="Realism tattoo" loading="lazy">
                    <figcaption>Realism</figcaption>
                </figure>

            </div>

        </section>

    </main>

</body>
</html>
