    </main>


    <script>

        const searchInput =
            document.getElementById("searchInput");

        const statusFilter =
            document.getElementById("statusFilter");

        const rows =
            document.querySelectorAll("#recordsTable tr");

        const noRecords =
            document.getElementById("noRecords");


        function filterRecords() {

            const search =
                searchInput.value.toLowerCase();

            const status =
                statusFilter.value;

            let visible = 0;


            rows.forEach(row => {

                const text =
                    row.textContent.toLowerCase();

                const statusText =
                    row.querySelector(".status")
                        .textContent.trim();


                const matchesSearch =
                    text.includes(search);

                const matchesStatus =
                    status === "all" ||
                    statusText === status;


                if (
                    matchesSearch &&
                    matchesStatus
                ) {

                    row.style.display = "";

                    visible++;

                } else {

                    row.style.display = "none";

                }

            });


            noRecords.style.display =
                visible === 0
                    ? "block"
                    : "none";
        }


        searchInput.addEventListener(
            "input",
            filterRecords
        );

        statusFilter.addEventListener(
            "change",
            filterRecords
        );

    </script>

</body>
